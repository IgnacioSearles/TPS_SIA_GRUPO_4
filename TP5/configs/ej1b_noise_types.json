{
  "seeds": [1, 2, 3],
  "dataset": {"type": "font"},
  "model": {
    "type": "autoencoder",
    "latent_size": 8,
    "hidden_layers": [32, 16],
    "activation": "tanh",
    "loss": "bce"
  },
  "training": {
    "epochs": 5000,
    "batch_size": 32,
    "optimizer": {"type": "adam", "learning_rate": 0.01},
    "log_every": 100
  },
  "grid": {
    "training.noise": [
      {"type": "flip", "level": 0.1},
      {"type": "mask", "level": 0.2},
      {"type": "salt_and_pepper", "level": 0.2},
      {"type": "gaussian", "level": 0.4}
    ],
    "evaluation.denoising": [
      {"type": "flip", "levels": [0, 0.05, 0.1, 0.15, 0.2], "trials": 50},
      {"type": "mask", "levels": [0, 0.1, 0.2, 0.3, 0.4], "trials": 50},
      {"type": "salt_and_pepper", "levels": [0, 0.1, 0.2, 0.3, 0.4], "trials": 50},
      {"type": "gaussian", "levels": [0, 0.2, 0.3, 0.4, 0.5], "trials": 50}
    ]
  },
  "evaluation": {
    "reconstruction": {}
  }
}

{
  "seed": 1,
  "dataset": {
    "type": "font"
  },
  "model": {
    "type": "autoencoder",
    "hidden_layers": [
      128,
      64
    ],
    "activation": "relu",
    "initializer": "he",
    "loss": "bce",
    "latent_size": 8
  },
  "training": {
    "epochs": 20000,
    "batch_size": 32,
    "optimizer": {
      "type": "adam",
      "learning_rate": 0.001
    },
    "log_every": 100,
    "noise": {
      "type": "flip",
      "level": 0.2
    }
  },
  "evaluation": {
    "reconstruction": {},
    "denoising": {
      "levels": {
        "flip": [
          0.0,
          0.05,
          0.1,
          0.2,
          0.3
        ],
        "mask": [
          0.15,
          0.3,
          0.6,
          0.91
        ],
        "salt_and_pepper": [
          0.1,
          0.2,
          0.4,
          0.6
        ],
        "gaussian": [
          0.3,
          0.39,
          0.59,
          0.95
        ]
      },
      "trials": 50,
      "examples": true
    }
  }
}

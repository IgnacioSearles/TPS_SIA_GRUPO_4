{
  "dataset": {
    "type": "synthetic_notes",
    "pitch_range": [
      48,
      72
    ],
    "pitch_study": {
      "omit_targets": false,
      "targets": [
        55,
        61,
        67
      ],
      "evaluation_variants": [
        "v00",
        "v20",
        "v39"
      ],
      "exclusion_radius": 0.75,
      "reserved_targets": [
        51,
        57,
        63
      ]
    },
    "spectrogram": {
      "duration_seconds": 1.0,
      "fft_size": 1024,
      "hop_length": 256,
      "mel_bands": 128
    },
    "variants_per_pitch": 40,
    "microtones_per_semitone": 4,
    "microtone_variants": 10
  },
  "model": {
    "type": "variational",
    "latent_size": 4,
    "hidden_layers": [
      512,
      128
    ],
    "activation": "relu",
    "initializer": "he",
    "loss": "mse",
    "kl": {
      "weight": 0.5,
      "warmup_epochs": 50
    },
    "precision": "float32"
  },
  "training": {
    "epochs": 200,
    "batch_size": 64,
    "optimizer": {
      "type": "adam",
      "learning_rate": 0.001
    },
    "log_every": 10
  },
  "evaluation": {
    "pitch_interpolation": {},
    "latent": {}
  },
  "seeds": [
    7,
    17,
    27
  ],
  "name": "ej2_pitch_latent_final_z4_complete"
}

{
  "seeds": [
    7,
    17,
    27
  ],
  "dataset": {
    "type": "geometric_shapes",
    "image_size": 32,
    "train_count": 1024,
    "test_count": 256,
    "data_seed": 20261113,
    "families": [
      "ellipse",
      "rectangle"
    ]
  },
  "model": {
    "type": "variational",
    "latent_size": 4,
    "hidden_layers": [
      128,
      32
    ],
    "activation": "relu",
    "initializer": "he",
    "loss": "bce",
    "precision": "float32",
    "kl": {
      "weight": 1.0,
      "warmup_epochs": 50
    }
  },
  "training": {
    "epochs": 300,
    "batch_size": 64,
    "log_every": 10,
    "optimizer": {
      "type": "adam",
      "learning_rate": 0.001
    }
  },
  "evaluation": {
    "reconstruction": {
      "max_examples": 12,
      "audio_examples": 0
    },
    "latent": {},
    "generative": {
      "count": 64,
      "test_examples": 12,
      "audio_examples": 0,
      "seed": 1234
    },
    "interpolation": {
      "random_pairs": 3,
      "steps": 9
    }
  },
  "grid": {
    "model.kl.weight": [
      0.0,
      0.1,
      4.0
    ]
  }
}

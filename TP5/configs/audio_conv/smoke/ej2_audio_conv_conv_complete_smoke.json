{
  "dataset": {
    "type": "synthetic_notes",
    "pitch_range": [
      48,
      72
    ],
    "pitch_study": {
      "omit_targets": false,
      "targets": [
        51,
        57,
        63
      ],
      "exclusion_radius": 0.75,
      "reserved_targets": [
        55,
        61,
        67
      ]
    },
    "spectrogram": {
      "duration_seconds": 1.0,
      "fft_size": 1024,
      "hop_length": 256,
      "mel_bands": 128
    },
    "variants_per_pitch": 1,
    "microtones_per_semitone": 1,
    "microtone_variants": 10
  },
  "model": {
    "type": "variational",
    "latent_size": 16,
    "hidden_layers": [
      512,
      128
    ],
    "activation": "relu",
    "initializer": "he",
    "loss": "mse",
    "kl": {
      "weight": 0.5,
      "warmup_epochs": 50
    },
    "precision": "float32",
    "architecture": "conv",
    "image_shape": [
      128,
      64,
      1
    ],
    "conv_channels": [
      8,
      16
    ]
  },
  "training": {
    "epochs": 2,
    "batch_size": 64,
    "optimizer": {
      "type": "adam",
      "learning_rate": 0.001
    },
    "log_every": 1
  },
  "evaluation": {
    "pitch_interpolation": {},
    "latent": {}
  },
  "seeds": [
    7
  ],
  "name": "ej2_audio_conv_conv_complete_smoke",
  "output": "results/ej2_audio_conv_conv_complete_smoke"
}

{
  "algorithm": "kohonen",
  "data": "data/creadores.csv",
  "output": "results/kohonen_suite/05_duration",
  "model": {
    "rows": 4,
    "cols": 4,
    "epochs": 500,
    "shuffle": true,
    "learning_rate_start": 0.3,
    "learning_rate_end": 0.01,
    "decay": "exponential",
    "radius_start": null,
    "radius_end": 0.5,
    "radius_decay": "exponential",
    "neighborhood": "gaussian",
    "initialization": "samples",
    "early_stopping": {
      "enabled": false
    }
  },
  "preprocessing": {
    "exclude": [
      "price_ars",
      "organic_posts_pct",
      "total_engagement_per_1000",
      "estimated_argentina_reach"
    ],
    "log_columns": [],
    "pca_components": null
  },
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "grid": {
    "model.topology": [
      "rectangular",
      "hexagonal"
    ],
    "model.epochs": [
      50,
      100,
      250,
      500,
      1000,
      2000
    ]
  }
}

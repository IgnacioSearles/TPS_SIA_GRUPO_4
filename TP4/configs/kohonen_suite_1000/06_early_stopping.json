{
  "algorithm": "kohonen",
  "data": "data/creadores.csv",
  "output": "results/kohonen_suite_1000/06_early_stopping",
  "model": {
    "rows": 4,
    "cols": 4,
    "epochs": 1000,
    "shuffle": true,
    "learning_rate_start": 0.3,
    "learning_rate_end": 0.01,
    "decay": "exponential",
    "radius_start": null,
    "radius_end": 0.5,
    "radius_decay": "exponential",
    "neighborhood": "gaussian",
    "initialization": "samples",
    "early_stopping": {
      "enabled": true
    },
    "schedule_epochs": 500
  },
  "preprocessing": {
    "exclude": [
      "price_ars",
      "organic_posts_pct",
      "total_engagement_per_1000",
      "estimated_argentina_reach"
    ],
    "log_columns": [],
    "pca_components": null
  },
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "grid": {
    "model.topology": [
      "rectangular",
      "hexagonal"
    ],
    "model.early_stopping.min_delta": [
      1e-06,
      0.0001,
      0.001,
      0.01
    ],
    "model.early_stopping.patience": [
      10,
      30,
      60
    ],
    "model.early_stopping.min_epochs": [
      50,
      150
    ]
  }
}

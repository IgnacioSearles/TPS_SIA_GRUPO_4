{
  "seed": 42,
  "data": {
    "path": "datasets/digits.csv",
    "validation_ratio": 0.2,
    "split_seed": 42
  },
  "model": {
    "layers": [784, 64, 64, 10],
    "activation": "tanh",
    "output_activation": "sigmoid",
    "initializer": "xavier"
  },
  "loss": "mse",
  "optimizer": {
    "name": "momentum",
    "lr": 0.1,
    "momentum": 0.9
  },
  "training": {
    "epochs": 350,
    "batch_size": 128,
    "shuffle_seed": 42,
    "early_stopping": {
      "patience": 40,
      "min_delta": 0.0005
    }
  },
  "study": {
    "architectures": [
      [784, 32, 32, 10],
      [784, 64, 64, 10],
      [784, 128, 128, 10]
    ],
    "seeds": [42, 7, 21]
  },
  "output": {
    "directory": "results/digits_width_sweep"
  }
}

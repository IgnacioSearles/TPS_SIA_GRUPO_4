{
  "files": ["datasets/digits.csv", "datasets/more_digits.csv"],
  "baseline_files": ["datasets/digits.csv"],
  "test_file": "datasets/digits_test.csv",
  "validation_ratio": 0.2,
  "split_seed": 2026,
  "seeds": [42, 7, 21],
  "model": {
    "layers": [784, 128, 128, 10],
    "activation": "tanh",
    "output_activation": "sigmoid",
    "initializer": "xavier"
  },
  "loss": "mse",
  "optimizer": {"name": "momentum", "lr": 0.1, "momentum": 0.9},
  "training": {
    "epochs": 150,
    "batch_size": 128,
    "early_stopping": {"patience": 50, "min_delta": 0.0005},
    "record_train_accuracy": false,
    "progress_every": 10
  },
  "augmentation": {
    "max_rotation": 10.0,
    "max_scale": 0.1,
    "max_shift": 2.0,
    "sigma": 0.0
  },
  "lr_search_epochs": 40,
  "study": {
    "rows": [0, 1, 2],
    "fixed_learning_rates": {
      "+ softmax y entropía cruzada": 0.01,
      "+ Adam": 0.001
    }
  },
  "output": {"directory": "reports/digits_e3_softmax_best_arch"}
}

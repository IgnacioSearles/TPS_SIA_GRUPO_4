{
  "seed": 42,
  "data": {
    "path": "datasets/digits.csv",
    "validation_ratio": 0.2,
    "split_seed": 42
  },
  "model": {
    "layers": [
      784,
      64,
      10
    ],
    "activation": "relu",
    "output_activation": "sigmoid",
    "initializer": "he"
  },
  "loss": "mse",
  "optimizer": {
    "name": "momentum",
    "lr": 0.1,
    "momentum": 0.9
  },
  "training": {
    "epochs": 350,
    "batch_size": 128,
    "shuffle_seed": 42,
    "early_stopping": {
      "patience": 40,
      "min_delta": 0.0005
    }
  },
  "study": {
    "max_hidden_layers": 8,
    "width": 64,
    "seeds": [
      42,
      7,
      21
    ],
    "patience": 2,
    "min_delta": 0.002,
    "stop_on_plateau": false
  },
  "output": {
    "directory": "results/digits_depth_sweep_relu_lr0.1"
  }
}

{
  "seed": 42,
  "model": {
    "activation": "sigmoid",
    "initializer": "uniform",
    "layers": [
      6,
      1
    ]
  },
  "loss": "mse",
  "optimizer": {
    "name": "sgd",
    "lr": 0.05
  },
  "training": {
    "epochs": 1000,
    "batch_size": 128,
    "epsilon": 0.001
  },
  "evaluation": {
    "classification": false
  },
  "output": {
    "directory": "reports/fraud_probability"
  },
  "callbacks": [],
  "dataset": "datasets/fraud_dataset.csv",
  "split": {
    "test_ratio": 0.2,
    "strata_bins": 10
  },
  "cross_validation": {
    "folds": 5
  },
  "notes": "split.test_ratio of the rows (stratified by target-probability deciles) are held out as a test set. K-Fold, tuning and threshold selection only use the development rows."
}
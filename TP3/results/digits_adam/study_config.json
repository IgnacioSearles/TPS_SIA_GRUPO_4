{
  "seed": 42,
  "model": {
    "activation": "tanh",
    "initializer": "xavier",
    "layers": [
      784,
      64,
      32,
      10
    ],
    "output_activation": "sigmoid"
  },
  "loss": "mse",
  "optimizer": {
    "name": "sgd",
    "lr": 0.1
  },
  "training": {
    "epochs": 500,
    "batch_size": 128,
    "epsilon": null,
    "shuffle_seed": 42
  },
  "evaluation": {
    "classification": false
  },
  "output": {
    "directory": "results/digits_adam"
  },
  "callbacks": [
    {
      "name": "progress",
      "every": 10
    }
  ],
  "data": {
    "path": "datasets/digits.csv",
    "validation_ratio": 0.2,
    "split_seed": 42
  },
  "study": {
    "seeds": [
      42,
      7,
      21,
      84,
      123
    ],
    "reuse_directory": null,
    "optimizers": [
      {
        "name": "adam",
        "lr": 0.0003
      },
      {
        "name": "adam",
        "lr": 0.001
      },
      {
        "name": "adam",
        "lr": 0.003
      }
    ]
  }
}
